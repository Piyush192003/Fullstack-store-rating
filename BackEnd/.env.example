# Copy this file to ".env" in the BackEnd folder and edit the values below.
# Do NOT commit your real .env (it contains secrets).

# Port the Express API listens on (Heroku sets PORT automatically)
PORT=5000

# MongoDB connection string
# Local dev:  mongodb://127.0.0.1:27017/store_rating_db
# Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/store_rating_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/store_rating_db

# Used to sign JWTs - change to a long random string
JWT_SECRET=change_this_to_a_long_random_secret

# Comma-separated frontend origins allowed by CORS
# e.g. https://your-app.vercel.app,https://your-custom-domain.com
# Leave empty to allow all origins (dev only).
FRONTEND_URL=http://localhost:5173