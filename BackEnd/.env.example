# Copy this file to ".env" in the BackEnd folder and edit the values below.
# Do NOT commit your real .env (it contains your DB password).

# Port the Express API listens on
PORT=5000

# MySQL connection
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=store_rating_db

# Used to sign JWTs - change to a long random string
JWT_SECRET=change_this_to_a_long_random_secret